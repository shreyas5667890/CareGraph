# CareGraph environment template.
# Copy to your shell environment (or a local .env) and fill in real values.
# Never commit real secrets.

# --- Doctor directory ---
# Path to the SQLite doctor database. Defaults to Data/caregraph_doctors.db
# CAREGRAPH_DOCTOR_DB=C:\Users\Shreyas\Desktop\CareGraph\Data\caregraph_doctors.db

# --- Flask session ---
# Required in production. A random per-process key is used if unset (sessions
# will not survive a restart).
# CAREGRAPH_SECRET_KEY=replace-with-a-long-random-value

# --- Admin dashboard (required for /api/admin/*) ---
# CAREGRAPH_ADMIN_USERNAME=admin
# Preferred: a Werkzeug password hash.
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
# CAREGRAPH_ADMIN_PASSWORD_HASH=
# Development convenience only: hashed at startup, never stored in source.
# CAREGRAPH_ADMIN_PASSWORD=

# --- Server / cookies / CORS ---
# Set to true when serving over HTTPS.
# CAREGRAPH_COOKIE_SECURE=false
# Only needed when the frontend is NOT using the Vite dev proxy.
# Must be a single origin, e.g. http://localhost:5173
# CAREGRAPH_FRONTEND_ORIGIN=
# CAREGRAPH_BACKEND_PORT=5000
# CAREGRAPH_DEBUG=false

# --- Frontend (build-time) ---
# Leave empty when using the Vite dev proxy (/api -> http://127.0.0.1:5000).
# VITE_API_BASE_URL=
